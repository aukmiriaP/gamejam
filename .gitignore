# This .gitignore is based on GitHub's Unity template.

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive.
[Mm]emoryCaptures/

# Recordings can get excessive.
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is ignored.
!/[Aa]ssets/**/*.meta

# Uncomment this line if you do not want to track Unity auto-generated asset store tools.
# [Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin.
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache/options.
.vs/
.vscode/
.idea/
ExportedObj/
consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated solution and project files.
sysinfo.txt
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports.
crashlytics-build.properties

# Packed Addressables.
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets.
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# Local AI/editor helper state.
.claude/
.codex/
.agents/
.mcp.json

# This project accidentally contains a plain "git" folder; Git repositories use ".git".
git/
